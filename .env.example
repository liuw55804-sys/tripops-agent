TRIPOPS_ENVIRONMENT=local
TRIPOPS_LOG_LEVEL=INFO
TRIPOPS_MODEL_PROVIDER=openai_compatible
TRIPOPS_MODEL_NAME=qwen-plus
TRIPOPS_MODEL_API_KEY=
TRIPOPS_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TRIPOPS_CHECKPOINT_DB=.tripops/checkpoints.sqlite
TRIPOPS_ARTIFACT_DIR=.tripops/artifacts
TRIPOPS_MAX_TOOL_CALLS=24
TRIPOPS_RUN_TIMEOUT_SECONDS=180

